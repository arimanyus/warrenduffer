# kotak | zerodha
BROKER=kotak

# Kotak Neo Trade API (BROKER=kotak). Login is automatic (TOTP + MPIN).
KOTAK_ACCESS_TOKEN=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=

# Zerodha Kite Connect (BROKER=zerodha). Access token expires daily: pnpm zerodha:login.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
# One-shot alternative to ZERODHA_ACCESS_TOKEN; single-use, expires in minutes.
ZERODHA_REQUEST_TOKEN=

# Jev: AI Gateway key, or a direct TypeSafe key. MODEL=mock observes only.
AI_GATEWAY_API_KEY=
TYPESAFE_AI_API_KEY=
MODEL=mock
OPTIONS_MODE=off
DECISION_INTERVAL_S=15
POSITION_INTERVAL_S=5
EXIT_CONFIRM_VOTES=2
WILD=0
ENTRY_START=09:30
ENTRY_END=15:00
FLATTEN_AT=15:10
RISK_PER_TRADE=300
MAX_NOTIONAL=150000
MAX_POSITIONS=3
DAILY_LOSS_CAP=1000
# 0 = no hard cap (the governor still throttles after losses)
MAX_TRADES_PER_DAY=0
# 0 = unlimited Jev tokens per day
JEV_DAILY_TOKEN_BUDGET=0
ON_RESTART=adopt
RSS_FEEDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=data/harness.db
# Keep loopback and use an SSH tunnel. A non-loopback HOST needs ALLOW_REMOTE_DASHBOARD=1,
# a DASHBOARD_TOKEN of 16+ chars, and (for 0.0.0.0) DASHBOARD_ALLOWED_HOSTS.
HOST=127.0.0.1
PORT=8080
ALLOW_REMOTE_DASHBOARD=0
# Empty = random per start (loopback only). Generate with: openssl rand -hex 24
DASHBOARD_TOKEN=
DASHBOARD_ALLOWED_HOSTS=
LIVE_QTY=0
CAPITAL=100000
RISK_PCT=0.003
JEV_TIMEOUT_MS=2500
ALLOW_MOCK_TRADING=0
WARMUP_DAYS=25
MAX_REQUOTES=3
KILL_PATH=kill.switch
