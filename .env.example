# kotak | zerodha
BROKER=kotak

# Kotak Neo Trade API (BROKER=kotak). Login is automatic (TOTP + MPIN).
KOTAK_ACCESS_TOKEN=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=

# Zerodha Kite Connect (BROKER=zerodha). Access token expires daily: pnpm zerodha:login.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
# One-shot alternative to ZERODHA_ACCESS_TOKEN; single-use, expires in minutes.
ZERODHA_REQUEST_TOKEN=

# Jev: AI Gateway key, or a direct TypeSafe key. MODEL=mock observes only.
AI_GATEWAY_API_KEY=
TYPESAFE_AI_API_KEY=
MODEL=mock
OPTIONS_MODE=off
UNIVERSE=nifty50
DECISION_INTERVAL_S=15
POSITION_INTERVAL_S=5
EXIT_CONFIRM_VOTES=2
WILD=0
ENTRY_START=09:30
ENTRY_END=15:00
FLATTEN_AT=15:10
RISK_PER_TRADE=300
MAX_NOTIONAL=150000
MAX_POSITIONS=3
DAILY_LOSS_CAP=1000
DAILY_FRICTION_BUDGET=400
ENTRIES_BASE=8
ENTRIES_MAX=16
ON_RESTART=adopt
RSS_FEEDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=data/harness.db
HOST=127.0.0.1
PORT=8080
LIVE_QTY=0
CAPITAL=100000
RISK_PCT=0.003
JEV_TIMEOUT_MS=2500
ALLOW_MOCK_TRADING=0
WARMUP_DAYS=25
MAX_REQUOTES=3
KILL_PATH=kill.switch
